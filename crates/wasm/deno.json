{
  "name": "@bedrock-crustaceans/brarchive",
  "version": "0.4.1",
  "license": "Apache-2.0",
  "exports": "./mod.ts",
  "tasks": {
    "wasmbuild": "deno run -A jsr:@deno/wasmbuild@0.23.0 -p brarchive-wasm",
    "wasmbuild:check": "deno run -A jsr:@deno/wasmbuild@0.23.0 -p brarchive-wasm --check",
    "test": "deno test --allow-read",
    "publish:dry": "deno publish --dry-run"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "@std/toml": "jsr:@std/toml@^1.0.10"
  },
  "publish": {
    "include": ["deno.json", "README.md", "mod.ts", "lib/"]
  },
  "fmt": {
    "exclude": ["lib/"]
  },
  "lint": {
    "exclude": ["lib/"]
  }
}
